<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:name=".PersonalHubApplication" android:label="PersonalHub" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.PersonalHub" android:allowBackup="false"
        android:fullBackupContent="false" android:dataExtractionRules="@xml/data_extraction_rules"
        android:supportsRtl="true" android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/vtop_network_security">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".CollegeConnectActivity" android:exported="false" android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".BlockedActivity" android:exported="false" android:excludeFromRecents="true"
            android:taskAffinity="dev.personalhub.blocked" android:launchMode="singleTask" />
        <service android:name="dev.personalhub.monitoring.UsageTrackerService" android:exported="true"
            android:label="@string/usage_tracker_label" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/usage_tracker" />
        </service>
    </application>
</manifest>
